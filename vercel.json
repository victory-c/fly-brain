{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'nothing to install'",
  "buildCommand": "mkdir -p site/dist && cp site/index.html site/dist/",
  "outputDirectory": "site/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://victory-c.github.io/fly-brain/$1",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
