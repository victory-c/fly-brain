{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'nothing to install'",
  "buildCommand": "bash site/build.sh",
  "outputDirectory": "site/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": true
    },
    {
      "source": "/bar/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/bar",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/classic",
      "destination": "/",
      "permanent": false
    }
  ]
}
